# Valor futuro con formula de Anualidades
ValorFuturo=function(A,r,Tp){
  xVFt=A*((((1+r)^Tp)-1)/r)
  return(xVFt)
}
# Anualidad con formula de Anualidades
Anualidad=function(VFt,r,Tp){
  xA=VFt/((((1+r)^Tp)-1)/r)
  return(xA)
}

# Numero de plazos
Plazos=function(VFt,r,A){
  Tp=log(((VFt*r)/A)+1)/log(1+r)
  xTp=round(Tp,0)
  return(xTp)
}

# Tasa del periodo
TasaP=function(VFt,A,Tp){
  ecuacion = function(r) {
    LadoIzquierdo = VFt / A
    LadoDerecho = ((1 + r) ^ Tp - 1) / r
    return(LadoIzquierdo - LadoDerecho)
  }
  
  # Usar la función uniroot para encontrar la raíz de la ecuación
  resultado = uniroot(ecuacion, lower = 0.0000001, upper = 1)
  
  # Mostrar el resultado
  r= resultado$root
  return(r)
  
}

# Valor actual
ValorActual=function(Ava,rVA,TpVA){
  VAt=Ava*((1-(1+rVA)^-TpVA)/rVA)
  xVAt=round(VAt,0)
  return(xVAt)
}
# Anualidad con valor actual
AnualidadVA=function(VAt,rVA,TpVA){
  xAva=VAt/((1-(1+rVA)^-TpVA)/rVA)
  return(xAva)
}
# Plazos con valor actual
PlazosVA=function(VAt,rVA,Ava){
  TpVA=-log(1-((VAt*rVA)/Ava))/log(1+rVA)
  xTpVA=round(TpVA,0)
  return(xTpVA)
}

# Tasa de periodo con Valor Actual
TasaPVA=function(VAt,TpVA,Ava){
  ecuacion2 = function(rVA) {
    LadoIzquierdo = VAt / Ava
    LadoDerecho = (1-((1+rVA)^-TpVA))/rVA
    return(LadoIzquierdo - LadoDerecho)
  }
  
  # Usar la función uniroot para encontrar la raíz de la ecuación
  resultado = uniroot(ecuacion2, lower = 0.000001, upper = 1)
  
  # Mostrar el resultado
  rVA= resultado$root
  return(rVA)
  
}